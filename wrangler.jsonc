{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "thefileswithdub",
  "account_id": "ea7a77735549fff1fba3e54e742e6e7b",
  "compatibility_date": "2026-09-12",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./worker/index.ts",
  "workers_dev": false,
  "preview_urls": true,
  "routes": [
    {
      "pattern": "www.thefileswithdub.com/*",
      "zone_name": "thefileswithdub.com"
    }
  ],
  "env": {
    "preview": {
      "workers_dev": true,
      "routes": []
    }
  },
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  }
}
