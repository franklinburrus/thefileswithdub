{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "thefileswithdub",
  "account_id": "ea7a77735549fff1fba3e54e742e6e7b",
  "compatibility_date": "2026-09-12",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./worker/index.ts",
  "workers_dev": false,
  "preview_urls": true,
  "vars": {
    "FORMS_MODE": "disabled"
  },
  // A default deploy is deliberately unrouted. Use --env preview for QA or
  // --env production only during an explicitly authorized cutover.
  "routes": [],
  "env": {
    "preview": {
      "name": "thefileswithdub-preview",
      "workers_dev": true,
      "vars": {
        "FORMS_MODE": "disabled"
      },
      "routes": []
    },
    "production": {
      "name": "thefileswithdub",
      "workers_dev": false,
      "vars": {
        "FORMS_MODE": "disabled"
      },
      "routes": [
        {
          "pattern": "www.thefileswithdub.com/*",
          "zone_name": "thefileswithdub.com"
        }
      ]
    }
  },
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true,
    "redact_query_string": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.1
    }
  }
}
