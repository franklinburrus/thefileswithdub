{
  "name": "site-creator-vinext-starter",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vite",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run build && node --test tests/*.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern worker-configuration.d.ts",
    "cf:types": "wrangler types worker-configuration.d.ts --config wrangler.jsonc",
    "cf:types:monitor": "wrangler types monitor/worker-configuration.d.ts --config wrangler.monitor.jsonc --env-interface MonitorEnv --include-runtime false",
    "typecheck": "npm run cf:types && npm run cf:types:monitor && tsc --noEmit --incremental false",
    "verify": "npm run lint && npm run typecheck && npm test",
    "broadcasts:sync": "node scripts/broadcasts-sync.mjs"
  },
  "dependencies": {
    "hls.js": "^1.6.16",
    "next": "16.4.1",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.67.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vinext/cloudflare": "^1.0.0-beta.7",
    "@vitejs/plugin-react": "6.1.1",
    "@vitejs/plugin-rsc": "^0.5.34",
    "eslint": "9.39.4",
    "eslint-config-next": "16.4.1",
    "react-server-dom-webpack": "19.3.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vinext": "^1.0.0-beta.9",
    "vite": "8.3.6",
    "wrangler": "4.156.1"
  },
  "type": "module"
}
